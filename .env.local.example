# Database (Neon - auto-set by Vercel)
DATABASE_URL=postgresql://user:pass@host/db

# Auth (Better Auth)
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Docker images (pre-built, no source in this repo)
DOCKER_IMAGE_GPU=ghcr.io/radishbuild/mirofish-gpu:latest

# Encryption key for provider credentials (generate via: openssl rand -hex 32)
ENCRYPTION_KEY=

# Resend (magic link email delivery — free at https://resend.com)
RESEND_API_KEY=

# Vercel Cron
CRON_SECRET=your-cron-secret
